# Copy this file to .env and fill in real values. .env is gitignored and
# never committed — see .gitignore. No script loads it on its own: pass it
# with `node --env-file=.env scripts/<script>.js`.

# GitHub personal access token for scripts/run-repo-scan.js's live GitHub
# code-search mode (docs/repo-scanner-github-scan.md). Needs only the
# "public_repo" scope -- this script only ever reads public search results,
# never writes anything to GitHub. Without this set, the script still runs
# in --dry-run mode (builds every query, sends none).
# scripts/pivot-handles-github.js reads the same variable for GitHub code
# search (docs/handle-pivot.md).
#
# Create one at https://github.com/settings/tokens (classic token, or a
# fine-grained token scoped to "Public Repositories (read-only)").
GITHUB_TOKEN=

# scripts/run-repo-scan.js: the GitHub owner whose own repositories the scan
# skips as self-matches. Defaults to chollimahunter.
# SCAN_SELF_OWNER=

# scripts/build-lazarus-registry.js: the date (YYYY-MM-DD) recorded as when the
# registry was transcribed. Defaults to today.
# REGISTRY_PULLED_AT=

# scripts/check-etherhiding-contracts.js: a JSON-RPC endpoint, bare or as
# chain=url, used when no --rpc flag is given
# (docs/etherhiding-contract-check.md).
# ETHERHIDING_RPC_URL=

# scripts/check-etherhiding-contracts.js: a block-explorer API base URL, used
# when no --explorer flag is given.
# ETHERHIDING_EXPLORER_URL=

# scripts/check-etherhiding-contracts.js: the API key for that explorer, used
# when no --explorer-key flag is given.
# ETHERHIDING_EXPLORER_KEY=

# scripts/check-indexing.js: the JSON key of a Google service account that is a
# user on the Search Console property, as one line (docs/search-indexing.md).
# GSC_SERVICE_ACCOUNT=

# src/_data/iocIndex.js: under `npm run serve`, build every indicator page
# instead of the first 400. Any non-empty value.
# ELEVENTY_ALL_INDICATORS=

# src/remote-workers/held-back/held-back.11tydata.js: write the local-only
# /remote-workers/held-back/ page in a plain build. Never set it for a build
# that will be deployed.
# ELEVENTY_PRIVATE_PAGES=

# scripts/serve-built.js (`npm run preview`): the port to serve _site on.
# Defaults to 8081.
# PREVIEW_PORT=

# scripts/serve-built.js: milliseconds without a request before the preview
# server stops itself. Defaults to 900000 (15 minutes).
# PREVIEW_IDLE_MS=
