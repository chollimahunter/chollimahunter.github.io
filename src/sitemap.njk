{#
  src/sitemap.njk — the sitemap index, which is what robots.txt and Search
  Console point at. It lists the files that hold the URLs:

    /sitemap-pages.xml          every hand-written and generated page that is
                                not an indicator (src/sitemap-pages.njk)
    /sitemap-indicators-N.xml   the /indicators/{id}/ pages, 5,000 to a file
                                (src/sitemap-indicators.njk)

  One file used to carry all 17,000 URLs. Splitting them lets a search engine
  fetch the 500 pages that matter most in a few kilobytes and report coverage
  for each run of indicator pages on its own, instead of one figure for the
  whole site. The run count comes from iocIndex.indicator_sitemaps so this
  index and the files it names cannot disagree.
#}<?xml version="1.0" encoding="UTF-8"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap><loc>{{ site.url }}/sitemap-pages.xml</loc></sitemap>
{%- for run in iocIndex.indicator_sitemaps %}
  <sitemap><loc>{{ site.url }}/sitemap-indicators-{{ loop.index }}.xml</loc></sitemap>
{%- endfor %}
</sitemapindex>
