      <p class="reading-list__note">Indictments, arrests and laptop-farm searches across sixteen states.</p>
    </li>
    <li>
      {% set externalLink = { url: "https://www.justice.gov/opa/pr/justice-department-announces-nationwide-actions-combat-illicit-north-korean-government", text: "Justice Department Announces Nationwide Actions to Combat Illicit North Korean Government Revenue Generation" } %}{% include "partials/external-link.njk" %}
