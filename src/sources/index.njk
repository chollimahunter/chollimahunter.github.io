    <li>
      {% set externalLink = { url: "https://www.crowdstrike.com/en-us/adversary-hub/", text: "CrowdStrike Adversary Hub" } %}{% include "partials/external-link.njk" %}
      <span class="reading-list__meta">CrowdStrike</span>
      <p class="reading-list__note">Profiles for each Chollima-suffixed adversary, the naming this site follows.</p>
    </li>
  </ul>
</section>
